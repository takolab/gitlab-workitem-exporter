# GitLab Personal Access Token
GITLAB_TOKEN=

# Optional: default --project value (e.g. your-group/your-project).
# An explicit --project flag always overrides this.
GITLAB_PROJECT=

# Comma-separated Work Item IIDs used for a multi Work Item export when
# --iid and --iids are both omitted. Ignored when either flag is given.
GITLAB_WORK_ITEM_IIDS=101,102,103

# Number of recent non-system comments included per Work Item in a multi
# Work Item export. Defaults to 10 when unset. Ignored by single Work Item
# export, which always includes all comments.
GITLAB_RECENT_COMMENTS_LIMIT=10
